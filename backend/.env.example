# Copy to .env and fill in. Everything has a working local default except the keys.

DATABASE_URL=postgresql+asyncpg://localhost/politiknow
REDIS_URL=redis://localhost:6379/0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

# Free key: https://api.congress.gov/sign-up  (DEMO_KEY works but is heavily rate-limited)
CONGRESS_API_KEY=DEMO_KEY
CONGRESS_NUMBER=119

# Paid per-use. Leave blank and summaries fall back to a labeled excerpt of the bill text.
OPENAI_API_KEY=

# Optional, free: OAuth client ID(s) from Google Cloud Console. Empty = Google sign-in hidden.
GOOGLE_CLIENT_IDS=[]

# Web app origins allowed to call the API
CORS_ORIGINS=["http://localhost:8081"]

# Feed recency: a bill's recency score halves every N days (try 90 for a more newest-first feed)
FEED_RECENCY_HALF_LIFE_DAYS=30

# Set to 0 locally so you can comment right after signing up (spec default is 60)
COMMENT_MIN_ACCOUNT_AGE_MINUTES=60
