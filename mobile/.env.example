# Copy to .env.local. All optional.

# Backend URL. Defaults: web -> http://localhost:8000, simulator/phone -> this computer's IP on port 8000.
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Google sign-in (free; create OAuth client IDs in Google Cloud Console). Button is hidden when unset.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
